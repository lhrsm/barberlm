import { createFileRoute, redirect } from "@tanstack/react-router";
import { useAuth } from "@/hooks/use-auth";
import { useEffect } from "react";
import { useNavigate } from "@tanstack/react-router";
import { Loader2 } from "lucide-react";

export const Route = createFileRoute("/$slug/portal")({
  beforeLoad: async ({ params, context }) => {
    // Note: TanStack Start server-side session check would go here, 
    // but we'll handle the redirect in the component for smoother SPA experience 
    // given the existing useAuth hook.
  },
  component: CustomerPortalGuard,
});

function CustomerPortalGuard() {
  const { user, loading, profile } = useAuth();
  const { slug } = Route.useParams();
  const navigate = useNavigate();

  useEffect(() => {
    if (!loading) {
      if (!user) {
        navigate({ to: "/auth" as any });
      } else if (profile && profile.identity_status === 'legacy') {
        navigate({ to: "/auth" as any });
      }
      // Se estiver logado, mas tentando acessar portal de outro tenant (barbearia)
      // a RLS da tabela 'customers' ou 'profiles' cuidará da segurança dos dados,
      // mas podemos adicionar uma validação extra aqui se profile.tenant_id existir.
    }
  }, [user, loading, profile, navigate]);

  if (loading || !user) {
    return (
      <div className="min-h-screen bg-[#05070d] flex items-center justify-center">
        <Loader2 className="h-10 w-10 text-gold animate-spin" />
      </div>
    );
  }

  // Se tudo ok, renderiza o portal real (que antes era o componente principal desta rota)
  return <CustomerPortalPage />;
}

